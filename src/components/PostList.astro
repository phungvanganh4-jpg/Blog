---
import { fmtDate, pad2, postUrl, type Post } from '../lib/posts';
import { seriesMeta } from '../site.config';

interface Props {
  posts: Post[];
  /** 系列页里用：左侧显示章节序号而不是系列名 */
  numbered?: boolean;
}
const { posts, numbered = false } = Astro.props;
---

<ul class="rows">
  {
    posts.map((post, i) => {
      const s = post.data.series ? seriesMeta[post.data.series] : undefined;
      return (
        <li>
          <a class="row" href={postUrl(post)}>
            {numbered && <span class="mono row-no">{pad2(post.data.order ?? i + 1)}</span>}
            <span class="row-title">
              {post.data.title}
              {post.data.draft && <span class="draft">草稿</span>}
            </span>
            <span class="mono row-meta">
              {!numbered && s && <span>{s.title}</span>}
              <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
            </span>
            <span class="row-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
